SENDER=dry_run                 # dry_run | instagrapi (real Instagram DMs) | official | telegram
TZ_NAME=Asia/Kolkata

# Route B (Instagram DMs; use a test account)
IG_USERNAME=
IG_PASSWORD=
IG_TOTP_SECRET=                # optional, recommended: base32 two-factor seed (authenticator app)
IG_VERIFICATION_CODE=          # optional: one-time code if Instagram asks for one at login

# Route A
IG_ACCESS_TOKEN=
IG_RECIPIENT_IGSID=

# Route D (optional: Telegram delivery; TELEGRAM_MY_CHAT_ID also gives alerts to yourself)
TELEGRAM_BOT_TOKEN=
TELEGRAM_FRIEND_CHAT_ID=
TELEGRAM_MY_CHAT_ID=

# Phone control via your bot (/add /pause /resume /status /queue). Needs the two
# Telegram values above; only messages from TELEGRAM_MY_CHAT_ID are accepted.
TELEGRAM_CONTROL=0             # 1 to enable

DASHBOARD_PASSWORD=change-me
