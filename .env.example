SENDER=dry_run                 # dry_run | instagrapi | official | telegram
TZ_NAME=Asia/Kolkata

# Route B
IG_USERNAME=
IG_PASSWORD=

# Route A
IG_ACCESS_TOKEN=
IG_RECIPIENT_IGSID=

# Route D (also used for alerts to yourself)
TELEGRAM_BOT_TOKEN=
TELEGRAM_FRIEND_CHAT_ID=
TELEGRAM_MY_CHAT_ID=

# Phone control via your bot (/add /pause /resume /status /queue). Needs the two
# Telegram values above; only messages from TELEGRAM_MY_CHAT_ID are accepted.
TELEGRAM_CONTROL=0             # 1 to enable

DASHBOARD_PASSWORD=change-me
